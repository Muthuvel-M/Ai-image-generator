{
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "framework": "nextjs",
    "outputDirectory": ".next",
    "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
    "functions": {
        "api/**/*.py": {
            "runtime": "python3.11",
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index"
        },
        {
            "source": "/videos/:path*",
            "destination": "/api/index"
        }
    ]
}